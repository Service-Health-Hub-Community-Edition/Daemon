-- Description: Sets index flag to specified value
--              Flag values:
--              -1 = Mark item for reindexing
--               0 = Item not indexed
--               1 = Item indexed
-- ====================================================
CREATE OR ALTER PROCEDURE [dbo].[proc_SetIndexFlag]
    @Id nvarchar(64),
    @Flag int = 1
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE
        [dbo].[Notifications]
    SET
        [Indexed]=@Flag
    WHERE
        [Id]=@Id
    END
