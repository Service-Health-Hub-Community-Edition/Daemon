--              routing rules
-- ====================================================
CREATE PROCEDURE [dbo].[proc_DeleteConnector]
    @ConnectorId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    
    DELETE FROM
        [dbo].[Routing]
    WHERE
        [Connector] = @ConnectorId

    DELETE FROM
        [dbo].[Connectors]
    WHERE
        [ConnectorId] = @ConnectorId
END
GO

