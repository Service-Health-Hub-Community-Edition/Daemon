    @TagId [uniqueidentifier]
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @existingId AS int = (SELECT [Id] FROM [dbo].[Tags] WHERE [MessageId]=@MessageId AND [Type]=@Type AND [TagId] = @TagId)
    
    IF (@existingId IS NULL)
    BEGIN
        INSERT INTO 
            [dbo].[Tags] ([MessageId], [Type], [TagId])
        VALUES 
            (@MessageId, @Type, @TagId)
    END
END
