CREATE FUNCTION [dbo].[fn_AllDistinctValues] (
    @propertyName nvarchar(64),
    @contentType nvarchar(128) = NULL
)
RETURNS TABLE
AS
RETURN
    SELECT DISTINCT 
        JSON_VALUE(Data, '$.'+@propertyName) AS Value
    FROM
        dbo.Notifications
    WHERE
        (JSON_VALUE(Data, '$.'+@propertyName) IS NOT NULL) AND
        [Type] = @contentType
