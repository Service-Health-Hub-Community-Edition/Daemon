-- Description: Retrieve newest Microsoft 365 usage statistics
-- ============================================================
CREATE VIEW [dbo].[GetLatestMonthlyUsageReport]
AS
        SELECT
        [Service],
        [Active],
        [Inactive],
        [ReportDate]
    FROM (
        SELECT
            [Service],
            [Active],
            [Inactive],
            [ReportDate],
            ROW_NUMBER() OVER (PARTITION BY [Service] ORDER BY [ReportDate] DESC) as MAX_ID
        FROM
            [dbo].[MonthlyActiveUsers]) mau
    WHERE MAX_ID = 1
GO                
